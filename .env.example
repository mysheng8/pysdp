# pySdp Environment Variables
# Copy this file to .env and fill in your values.
# .env is git-ignored and never committed.

# SDPCLI server (if running separately)
PYSDP_SDPCLI_URL=http://localhost:5000

# LLM — DrawCall labeling
PYSDP_LLM_ENDPOINT=
PYSDP_LLM_KEY=
PYSDP_LLM_MODEL=

# VLM — Vision / screenshot analysis
PYSDP_VLM_ENDPOINT=
PYSDP_VLM_KEY=
PYSDP_VLM_MODEL=

# Chat AI — WebUI sidebar
PYSDP_CHAT_ENDPOINT=
PYSDP_CHAT_KEY=
PYSDP_CHAT_MODEL=

# Paths (optional — defaults work for standard layout)
# PYSDP_WORKING_DIR=
# PYSDP_PROJECT_DIR=
# PYSDP_SDP_DIR=
# PYSDP_ANALYSIS_DIR=
# PYSDP_REPORT_DIR=

# Logging
# PYSDP_LOG_LEVEL=info
